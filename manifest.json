{
  "manifest_version": 3,
  "name": "ChatGPT Prompt Queuer",
  "version": "1.0.0",
  "description": "Queue and automatically send multiple prompts to ChatGPT",
                "permissions": [
                "activeTab",
                "storage",
                "tabs"
              ],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatGPT Prompt Queuer"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
      "js": ["content.js", "page-ui.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
} 